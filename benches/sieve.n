// Expected:
// 1085

val n = args.size() > 0 ? args[0].toInt() : 100

val is_prime = []
var i = 0
while i <= n {
    is_prime.push(true)
    i = i + 1
}
is_prime[0] = false
is_prime[1] = false

var p = 2
while p * p <= n {
    if is_prime[p] {
        var multiple = p * p
        while multiple <= n {
            is_prime[multiple] = false
            multiple = multiple + p
        }
    }
    p = p + 1
}

var count = 0
var sum = 0
i = 0
while i <= n {
    if is_prime[i] {
        count = count + 1
        sum = (sum + i) % 1000000007
    }
    i = i + 1
}

print((count + sum) % 1000000007)
