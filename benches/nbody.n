// Expected:
// -169026909

import "std/math"

struct Body {
    x
    y
    z
    vx
    vy
    vz
    mass
}

val PI = 3.141592653589793
val SOLAR_MASS = 4 * PI * PI
val DAYS_PER_YEAR = 365.24

fn make_bodies() {
    val jupiter = Body(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01, 1.66007664274403694e-03 * DAYS_PER_YEAR, 7.69901118419740425e-03 * DAYS_PER_YEAR, -6.90460016972063023e-05 * DAYS_PER_YEAR, 9.54791938424326609e-04 * SOLAR_MASS)
    val saturn = Body(8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01, -2.76742510726862411e-03 * DAYS_PER_YEAR, 4.99852801234917238e-03 * DAYS_PER_YEAR, 2.30417297573763929e-05 * DAYS_PER_YEAR, 2.85885980666130812e-04 * SOLAR_MASS)
    val uranus = Body(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01, 2.96460137564761618e-03 * DAYS_PER_YEAR, 2.37847173959480950e-03 * DAYS_PER_YEAR, -2.96589568540237556e-05 * DAYS_PER_YEAR, 4.36624404335156298e-05 * SOLAR_MASS)
    val neptune = Body(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01, 2.68067772490389322e-03 * DAYS_PER_YEAR, 1.62824170038242295e-03 * DAYS_PER_YEAR, -9.51592254519715870e-05 * DAYS_PER_YEAR, 5.15138902046611451e-05 * SOLAR_MASS)
    return [Body(0, 0, 0, 0, 0, 0, SOLAR_MASS), jupiter, saturn, uranus, neptune]
}

fn offset_momentum(bodies) {
    var px = 0
    var py = 0
    var pz = 0
    for b in bodies {
        px = px + b.vx * b.mass
        py = py + b.vy * b.mass
        pz = pz + b.vz * b.mass
    }
    val sun = bodies[0]
    sun.vx = -px / SOLAR_MASS
    sun.vy = -py / SOLAR_MASS
    sun.vz = -pz / SOLAR_MASS
}

fn advance(bodies, dt) {
    val count = bodies.size()
    var i = 0
    while i < count {
        val bi = bodies[i]
        var j = i + 1
        while j < count {
            val bj = bodies[j]
            val dx = bi.x - bj.x
            val dy = bi.y - bj.y
            val dz = bi.z - bj.z
            val d2 = dx * dx + dy * dy + dz * dz
            val mag = dt / (d2 * math.sqrt(d2))
            bi.vx = bi.vx - dx * bj.mass * mag
            bi.vy = bi.vy - dy * bj.mass * mag
            bi.vz = bi.vz - dz * bj.mass * mag
            bj.vx = bj.vx + dx * bi.mass * mag
            bj.vy = bj.vy + dy * bi.mass * mag
            bj.vz = bj.vz + dz * bi.mass * mag
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < count {
        val b = bodies[i]
        b.x = b.x + dt * b.vx
        b.y = b.y + dt * b.vy
        b.z = b.z + dt * b.vz
        i = i + 1
    }
}

fn energy(bodies) {
    var e = 0
    val count = bodies.size()
    var i = 0
    while i < count {
        val bi = bodies[i]
        e = e + 0.5 * bi.mass * (bi.vx * bi.vx + bi.vy * bi.vy + bi.vz * bi.vz)
        var j = i + 1
        while j < count {
            val bj = bodies[j]
            val dx = bi.x - bj.x
            val dy = bi.y - bj.y
            val dz = bi.z - bj.z
            val distance = math.sqrt(dx * dx + dy * dy + dz * dz)
            e = e - (bi.mass * bj.mass) / distance
            j = j + 1
        }
        i = i + 1
    }
    return e
}

val n = args.size() > 0 ? args[0].toInt() : 200

val bodies = make_bodies()
offset_momentum(bodies)

var step = 0
while step < n {
    advance(bodies, 0.01)
    step = step + 1
}

print(math.floor(energy(bodies) * 1000000000))
