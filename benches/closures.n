// Expected:
// 829580

val n = args.length() > 0 ? args[0].toInt() : 500

fn make_counter(start) {
    var value = start
    fn inc(step) {
        value = value + step
        return value
    }
    return inc
}

var total = 0
var i = 0
while (i < n) {
    val counter = make_counter(i % 13)
    var j = 0
    while (j < 20) {
        total = (total + counter(j + 1)) % 1000000007
        j = j + 1
    }
    i = i + 1
}

print(total)
