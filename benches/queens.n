// Expected:
// 2

struct Queens {
    var freeRows
    var freeMaxs
    var freeMins
    var queenRows
}

impl Queens {
    fn queens(self) {
        self.freeRows = Array(8, true)
        self.freeMaxs = Array(16, true)
        self.freeMins = Array(16, true)
        self.queenRows = Array(8, -1)
        self.placeQueen(0)
    }

    fn placeQueen(self, c) {
        for r in 0..8 {
            if self.getRowColumn(r, c) {
                self.queenRows[r] = c
                self.setRowColumn(r, c, false)

                if c == 7 {
                    return true
                }
                if self.placeQueen(c + 1) {
                    return true
                }

                self.setRowColumn(r, c, true)
            }
        }
        false
    }

    fn getRowColumn(self, r, c) {
        self.freeRows[r] && self.freeMaxs[c + r] && self.freeMins[c - r + 7]
    }

    fn setRowColumn(self, r, c, v) {
        self.freeRows[r] = v
        self.freeMaxs[c + r] = v
        self.freeMins[c - r + 7] = v
    }
}

fn benchmark() {
    val queens = Queens(nil, nil, nil, nil)
    var result = true
    for _ in 0..10 {
        result = result && queens.queens()
    }
    result
}

val iterations = args.size() > 0 ? args[0].toInt() : 2

var checksum = 0
for _ in 0..iterations {
    val result = benchmark()
    if !result {
        throw "Queens verification failed"
    }
    checksum += 1
}
print(checksum)
