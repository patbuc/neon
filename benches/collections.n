// Expected:
// 3692

val n = args.size() > 0 ? args[0].toInt() : 50

val arr = []
var i = 0
while i < n {
    arr.push(i * 2)
    i = i + 1
}

val m = {}
i = 0
while i < n {
    m["key" + i.toString()] = i
    i = i + 1
}

val s = #{}
i = 0
while i < n {
    s.add(i * 3)
    i = i + 1
}

var checksum = 0
i = 0
while i < n {
    checksum = (checksum + arr[i]) % 1000000007
    val key = "key" + i.toString()
    if m.contains(key) {
        checksum = (checksum + m[key]) % 1000000007
    }
    if s.contains(i) {
        checksum = (checksum + 1) % 1000000007
    }
    i = i + 1
}

print(checksum)
