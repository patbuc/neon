// Expected:
// 128

fn mandelbrot(size) {
    var sum = 0
    var byteAcc = 0
    var bitNum = 0

    var y = 0
    while y < size {
        val ci = (2.0 * y / size) - 1.0
        var x = 0

        while x < size {
            var zrzr = 0.0
            var zi = 0.0
            var zizi = 0.0
            val cr = (2.0 * x / size) - 1.5

            var z = 0
            var notDone = true
            var escape = 0
            while notDone && z < 50 {
                val zr = zrzr - zizi + cr
                zi = 2.0 * zr * zi + ci

                zrzr = zr * zr
                zizi = zi * zi

                if zrzr + zizi > 4.0 {
                    notDone = false
                    escape = 1
                }
                z += 1
            }

            byteAcc = (byteAcc << 1) + escape
            bitNum += 1

            if bitNum == 8 {
                sum = sum ^ byteAcc
                byteAcc = 0
                bitNum = 0
            } else if x == size - 1 {
                byteAcc = byteAcc << (8 - bitNum)
                sum = sum ^ byteAcc
                byteAcc = 0
                bitNum = 0
            }
            x += 1
        }
        y += 1
    }
    sum
}

val size = args.size() > 0 ? args[0].toInt() : 1

val result = mandelbrot(size)
if size == 1 && result != 128 {
    throw "Mandelbrot verification failed"
}
if size == 500 && result != 191 {
    throw "Mandelbrot verification failed"
}
if size == 750 && result != 50 {
    throw "Mandelbrot verification failed"
}
print(result)
