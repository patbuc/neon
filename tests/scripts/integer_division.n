// Expected:
// 3
// 3
// -4
// 2
// 5
// -3
// 1
// 0
// -1

import "std/math"

// Basic integer division
print(math.floor(10 / 3))

// Another basic case
print(math.floor(7 / 2))

// Floor division with negative dividend (rounds toward negative infinity)
print(math.floor(-7 / 2))

// Even division
print(math.floor(10 / 4))

// Larger numbers
print(math.floor(25 / 5))

// Negative divisor
print(math.floor(10 / -4))

// Both positive, result is 1
print(math.floor(5 / 4))

// Small dividend
print(math.floor(1 / 2))

// Negative dividend, positive divisor
print(math.floor(-1 / 2))
