// neon.28.n - Map methods (get, contains, remove)

// Expected:
// Alice
// nil
// true
// false
// 30
// 1
// true
// false
// 1

// Map get method
val person = {"name": "Alice", "age": 30}
print(person.get("name")) // Alice
print(person.get("missing")) // nil

// Map contains method
print(person.contains("name")) // true
print(person.contains("missing")) // false

// Map remove method
val removed = person.remove("age")
print(removed) // 30
print(person.size()) // 1

// Verify key was removed
print(person.contains("name")) // true
print(person.contains("age")) // false
print(person.size()) // 1
