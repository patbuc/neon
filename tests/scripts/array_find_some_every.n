// Expected:
// 2
// nil
// false
// true
// [1, 2]
// [1, 2]
// [1, 2]

print([1, 2, 3].find { it > 1 })
print([1, 2, 3].find { it > 10 })
print([].some { x -> true })
print([].every { x -> false })

val someCalls = []
[1, 2, 3].some {
    someCalls.push(it)
    it >= 2
}
print(someCalls)

val everyCalls = []
[1, 2, 3].every {
    everyCalls.push(it)
    it < 2
}
print(everyCalls)

val findCalls = []
[1, 2, 3].find {
    findCalls.push(it)
    it >= 2
}
print(findCalls)
