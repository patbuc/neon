// Expected:
// [1, 2, 3]
// [1, 2, 3, 4]
// [3, 2, 1]
// [[1, a], [1, b], [0, c], [1, d]]
// [[0, c], [1, a], [1, b], [1, d]]

val a = [3, 1, 2]
val b = a.sort()
print(b)
b.push(4)
print(a)

print([3, 1, 2].sort { x, y -> y - x })

val pairs = [[1, "a"], [1, "b"], [0, "c"], [1, "d"]]
print(pairs.sort { x, y -> 0 })
print(pairs.sort { x, y -> x[0] - y[0] })
