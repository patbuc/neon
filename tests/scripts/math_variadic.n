// 1
// 8
// 3
// 7
// 42
// 42
// -8
// -2
// -10
// 10
// 5
// 5

import "std/math"

print(math.min(5, 2, 8, 1))
print(math.max(5, 2, 8, 1))
print(math.min(3, 7))
print(math.max(3, 7))
print(math.min(42))
print(math.max(42))
print(math.min(-5, -2, -8))
print(math.max(-5, -2, -8))
print(math.min(10, -3, 5, -10))
print(math.max(10, -3, 5, -10))
print(math.min(5, 5, 5))
print(math.max(5, 5, 5))
