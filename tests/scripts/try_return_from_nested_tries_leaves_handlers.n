// Expected:
// returned
// caught late

fn f(depth) {
    if depth > 0 {
        print(f(depth - 1))
        throw "late"
    }
    try {
        try {
            return "returned"
        } catch (e) {
            return "stale inner ${e}"
        }
    } catch (e) {
        return "stale outer ${e}"
    }
}

try {
    f(1)
} catch (e) {
    print("caught ${e}")
}
