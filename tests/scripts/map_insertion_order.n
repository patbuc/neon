// neon.100.n - Maps preserve insertion order

// Expected:
// {k13: 13, k2: 2, k19: 19, k7: 7, k1: 1, k16: 16, k4: 4, k20: 20, k9: 9, k11: 11, k3: 3, k18: 18, k6: 6, k14: 14, k8: 8, k17: 17, k5: 5, k12: 12, k10: 10, k15: 15}
// [k13, k2, k19, k7, k1, k16, k4, k20, k9, k11, k3, k18, k6, k14, k8, k17, k5, k12, k10, k15]
// [13, 2, 19, 7, 1, 16, 4, 20, 9, 11, 3, 18, 6, 14, 8, 17, 5, 12, 10, 15]
// [[k13, 13], [k2, 2], [k19, 19], [k7, 7], [k1, 1], [k16, 16], [k4, 4], [k20, 20], [k9, 9], [k11, 11], [k3, 3], [k18, 18], [k6, 6], [k14, 14], [k8, 8], [k17, 17], [k5, 5], [k12, 12], [k10, 10], [k15, 15]]
// k13
// k2
// k19
// k7
// k1
// k16
// k4
// k20
// k9
// k11
// k3
// k18
// k6
// k14
// k8
// k17
// k5
// k12
// k10
// k15
// [k13, k2, k7, k1, k16, k4, k20, k9, k11, k3, k18, k6, k14, k8, k17, k5, k12, k10, k15]
// [k13, k2, k7, k1, k16, k4, k20, k9, k11, k3, k18, k6, k14, k8, k17, k5, k12, k10, k15, k19]

// 20 keys inserted in a scrambled (non-sorted) order, so a HashMap would
// only match this order by astronomically unlikely chance.
var m = {
    "k13": 13, "k2": 2, "k19": 19, "k7": 7, "k1": 1,
    "k16": 16, "k4": 4, "k20": 20, "k9": 9, "k11": 11,
    "k3": 3, "k18": 18, "k6": 6, "k14": 14, "k8": 8,
    "k17": 17, "k5": 5, "k12": 12, "k10": 10, "k15": 15
}

print(m)
print(m.keys())
print(m.values())
print(m.entries())

for (key in m) {
    print(key)
}

// Removing a key in the middle must keep the relative order of the rest.
m.remove("k19")
print(m.keys())

// Re-inserting a removed key must place it at the end, not its old slot.
m["k19"] = 19
print(m.keys())
