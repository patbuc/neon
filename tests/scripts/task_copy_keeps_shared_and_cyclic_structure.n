// task_copy_keeps_shared_and_cyclic_structure.n - copying across a task
// boundary keeps two references to one array as one array, and handles cycles

// Expected:
// true
// true

val t = Task(fn(pair) {
    pair[0].push(1)
    return pair[1].length() == 1
})
val shared = []
print(t.run([shared, shared]))

val cyclic = []
cyclic.push(cyclic)
val u = Task(fn(xs) {
    return xs[0][0][0] == xs
})
print(u.run(cyclic))
