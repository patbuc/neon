// Expected:
// caught deep
// 1000
// 7
// 2000
// 3000
// after

fn deep(a, b) {
    val x = a * 10
    val y = b * 100
    throw "deep"
    x + y
}

fn middle(n) {
    val p = n + 1
    val q = p + 1
    val r = deep(p, q)
    p + q + r
}

fn outer() {
    val base = 1000
    val a = 100
    var total = 0
    try {
        val inside = 10
        total = a + inside + 1 + middle(1)
    } catch (e) {
        print("caught " + e)
        print(base)
    }
    val k = 7
    print(k)
    print(base + base)
    total
}

val t = outer()
print(t + 3000)
print("after")
