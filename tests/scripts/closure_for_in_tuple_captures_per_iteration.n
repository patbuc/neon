// Expected:
// a 1
// b 2
// c 3

var closures = []
for (k, v) in {"a": 1, "b": 2, "c": 3, "d": 4} {
    fn makeGetter() {
        return k + " " + v.toString()
    }
    closures.push(makeGetter)
    if k == "a" {
        continue
    }
    if k == "c" {
        break
    }
}

for getter in closures {
    print(getter())
}
