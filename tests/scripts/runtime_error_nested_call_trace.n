// A runtime error raised after returning through several nested calls: each
// return must restore its caller's chunk correctly before the error occurs.

// Expected:
// before

// Expected runtime error: Operands must be two numbers or two strings

fn inner() {
    return 1
}

fn middle() {
    val a = inner()
    return a + true
}

fn outer() {
    return middle()
}

print("before")
outer()
