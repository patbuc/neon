// task_runs_fibers_internally.n - a task can create and drive its own fibers

// Expected:
// 15

val t = Task(fn(n) {
    val g = Fiber(fn() {
        for (i in 1..=n) {
            Fiber.yield(i)
        }
        return 0
    })
    var sum = 0
    while (!g.isDone()) {
        sum = sum + g.call()
    }
    return sum
})
print(t.run(5))
