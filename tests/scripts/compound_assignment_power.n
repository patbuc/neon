var x = 2
x **= 3
print(x)

var y = 2
y **= 1 + 1
print(y)

fn square() {
    var n = 3
    n **= 2
    return n
}
print(square())

fn counter() {
    var n = 3
    fn inc() {
        n **= 2
        return n
    }
    return inc
}

val c = counter()
print(c())
print(c())
