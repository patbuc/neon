// priority_queue_basic.n - push/pop ordering, FIFO ties, peek, size, and
// the print format

// Expected:
// a
// b
// c
// nil
// first
// second
// PriorityQueue(size=1)
// x
// PriorityQueue(size=1)
// x
// PriorityQueue(size=0)

import "std/pq"

val queue = pq.new()
queue.push(3, "c")
queue.push(1, "a")
queue.push(2, "b")
print(queue.pop())
print(queue.pop())
print(queue.pop())
print(queue.pop())

val ties = pq.new()
ties.push(5, "first")
ties.push(5, "second")
print(ties.pop())
print(ties.pop())

val peeked = pq.new()
peeked.push(1, "x")
print(peeked)
print(peeked.peek())
print(peeked)
print(peeked.pop())
print(peeked)
