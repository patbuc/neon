// Expected:
// pos
// neg
// 1
// 1
// [1, 3]
// 1
// nil
// nil
// inner
// nil
// 5

val n1 = 5
val s1 = if n1 > 0 {
    "pos"
} else if n1 < 0 {
    "neg"
} else {
    "zero"
}
print(s1)

val n2 = -3
val s2 = if n2 > 0 {
    "pos"
} else if n2 < 0 {
    "neg"
} else {
    "zero"
}
print(s2)

val n3 = 0
val s3 = if n3 > 0 {
    "pos"
} else if n3 < 0 {
    "neg"
} else {
    val t = n3 * 2
    t + 1
}
print(s3)

print(if true {
    1
} else {
    2
})

val a = true
print([if a {
    1
} else {
    2
}, 3])

fn f(x) {
    return x
}
print(f(if a {
    1
} else {
    2
}))

val r1 = if true {
    val z = 1
} else {
    0
}
print(r1)

val r2 = if true {
    for i in 0..1 {}
} else {
    0
}
print(r2)

val r3 = if true {
    print("inner")
} else {
    0
}
print(r3)

val g = if true {
    val k = 5
    fn() {
        k
    }
} else {
    fn() {
        0
    }
}
print(g())
