// Expected:
// 30
// 7.5
// 7.5
// 5.5
// 5
// 5.5
// 5.5
// -3
// 1.5
// 3
// 3.5
// 2
// 2.5

fn product(a, b) {
    return a * b
}

fn productLocals(x, y) {
    val a = x
    val b = y
    return a * b
}

print(product(5, 6))
print(product(2.5, 3.0))
print(productLocals(2.5, 3))

fn sumLocals(x, y) {
    val a = x
    val b = y
    return a + b
}

fn differenceLocals(x, y) {
    val a = x
    val b = y
    return a - b
}

fn quotientLocals(x, y) {
    val a = x
    val b = y
    return a / b
}

print(sumLocals(2.5, 3.0))
print(sumLocals(2, 3))
print(sumLocals(2.5, 3))
print(differenceLocals(7.5, 2.0))
print(differenceLocals(2, 5))
print(differenceLocals(2.5, 1))
print(quotientLocals(7.5, 2.5))
print(quotientLocals(7, 2))
print(quotientLocals(6, 3))
print(quotientLocals(7.5, 3))
