// Expected:
// 10
// 20
// 30
// 7
// 8
// 9

fn inner() {
    yield 1
    yield 2
    yield 3
}

fn outer() {
    for x in inner() {
        yield x * 10
    }
    return 99
}

for v in outer() {
    print(v)
}

fn middle() {
    for x in outer() {
        for y in inner() {
            if y == 1 {
                yield x
            }
        }
    }
}

fn run() {
    for v in [7, 8, 9] {
        for m in middle() {
            if m == 10 {
                print(v)
            }
        }
    }
}

run()
