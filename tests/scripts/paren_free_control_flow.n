// Expected:
// positive
// negative
// zero
// 0
// 1
// 2
// 10
// 20

val x = 3
if x > 0 {
    print("positive")
} else if x < 0 {
    print("negative")
} else {
    print("zero")
}

val y = -1
if y > 0 {
    print("positive")
} else if y < 0 {
    print("negative")
} else {
    print("zero")
}

val z = 0
if z > 0 {
    print("positive")
} else if z < 0 {
    print("negative")
} else {
    print("zero")
}

var i = 0
val n = 3
while i < n {
    print(i)
    i = i + 1
}

for x in [10, 20] {
    print(x)
}
