// Calling an instance method on the struct type itself

// Expected:
// before

// Expected runtime error: Method 'm' needs an instance; call it on a P value

struct P {
    x
}

impl P {
    fn m(self) {
        return self.x
    }
}

fn callStatic(s) {
    return s.m()
}

print("before")
callStatic(P)
