// Expected:
// 0
// 1
// 3
// 4
// ---
// 0
// 1
// 3
// 4

var printed = []
var closures = []
for (var i = 0; i < 5; i = i + 1) {
    if (i == 2) {
        i = i + 1
    }
    printed.push(i)
    closures.push(fn() { return i })
}
for (p in printed) {
    print(p)
}
print("---")
for (c in closures) {
    print(c())
}
