// Expected:
// 10
// 10
// 3.5

fn countPlusEquals() {
    var i = 0
    while i < 10 {
        i += 1
    }
    return i
}

fn countAssign() {
    var i = 0
    while i < 10 {
        i = i + 1
    }
    return i
}

fn countFloat() {
    var x = 0.5
    var n = 0
    while n < 3 {
        x += 1
        n += 1
    }
    return x
}

print(countPlusEquals())
print(countAssign())
print(countFloat())
