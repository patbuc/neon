// Expected:
// 9
// 2
// 5
// 5
// 10
// early

fn sq(x) {
    x * x
}
print(sq(3))

val f = fn(x) {
    x + 1
}
print(f(1))

struct P {
    x
}

impl P {
    fn len(self) {
        self.x
    }
}
print(P(5).len())

fn assignTail() {
    var y = 0
    y = 5
}
print(assignTail())

fn explicitReturn() {
    return 10
}
print(explicitReturn())

fn earlyReturn(flag) {
    if flag {
        return "early"
    }
    "late"
}
print(earlyReturn(true))
