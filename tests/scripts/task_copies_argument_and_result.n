// task_copies_argument_and_result.n - a task gets a copy of its argument,
// can call global functions, and hands back a copy of its result

// Expected:
// [1, 2]
// [1, 4, 9801]
// true
// <task>

fn square(x) {
    return x * x
}

val t = Task(fn(data) {
    data.push(99)
    val out = []
    for (v in data) {
        out.push(square(v))
    }
    return out
})

val input = [1, 2]
val result = t.run(input)
print(input)
print(result)
print(t.isDone())
print(t)
