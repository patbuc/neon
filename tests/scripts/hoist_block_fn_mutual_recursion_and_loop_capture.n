// Expected:
// even
// odd
// yes
// 1
// 2
// 4
// 5

fn classify(n) {
    fn is_even(n) {
        if (n == 0) { return "even" }
        return is_odd(n - 1)
    }
    fn is_odd(n) {
        if (n == 0) { return "odd" }
        return is_even(n - 1)
    }
    return is_even(n)
}

print(classify(4))
print(classify(3))

{
    fn is_even2(n) {
        if (n == 0) { return true }
        return is_odd2(n - 1)
    }
    fn is_odd2(n) {
        if (n == 0) { return false }
        return is_even2(n - 1)
    }
    if (is_even2(6)) {
        print("yes")
    }
}

var last = nil
var i = 0
while (i < 5) {
    i = i + 1
    if (i == 3) {
        continue
    }
    fn report() {
        return i
    }
    if (i == 5) {
        break
    }
    print(report())
    last = report
}
print(last())
