// {1: [1, 3], 0: [2, 4]}
// {1: 1, 2: 1, 3: 1}

print([4, 1, 3, 2].sortBy { it })
print([4, 1, 3, 2].minBy { it })
print([4, 1, 3, 2].maxBy { it })
print([1, 2, 3, 4].groupBy { it % 2 })
print(["a", "b", "a", "c"].tally())

print((1..5).sortBy { it })
print((1..5).minBy { it })
print((1..5).maxBy { it })
print((1..5).groupBy { it % 2 })
print((1..4).tally())
