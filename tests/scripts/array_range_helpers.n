val arr = [1, 2, 3, 4, 5]
print(arr.forEach { print(it) })
print(arr.flatMap { [it, it] })
print(arr.take(2))
print(arr.drop(2))
print(arr.first())
print(arr.last())
print(arr.chunked(2))
print(arr.zip(["a", "b"]))
print(arr.withIndex().take(3))

val rng = 1..=5
print(rng.forEach { print(it) })
print(rng.flatMap { [it, it] })
print(rng.take(2))
print(rng.drop(2))
print(rng.first())
print(rng.last())
print(rng.chunked(2))
print(rng.zip([10, 20]))
print(rng.withIndex().take(3))

print([1, 2, 3].take(9))
print([1, 2, 3].drop(9))
print([].first())
print([].last())
print((1..3).zip(1..3))
print(["a", "b"].withIndex())
