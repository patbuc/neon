{
  "name": "neon",
  "displayName": "Neon",
  "description": "Syntax highlighting, formatting and diagnostics for the Neon language",
  "version": "0.1.0",
  "publisher": "patbuc",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/patbuc/neon"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:neon"
  ],
  "contributes": {
    "configurationDefaults": {
      "[neon]": {
        "editor.formatOnSave": true
      }
    },
    "languages": [
      {
        "id": "neon",
        "aliases": [
          "Neon",
          "neon"
        ],
        "extensions": [
          ".n"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/neon-file.svg",
          "dark": "./images/neon-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "neon",
        "scopeName": "source.neon",
        "path": "./syntaxes/neon.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "neon",
        "path": "./snippets/neon.json"
      }
    ],
    "configuration": {
      "title": "Neon",
      "properties": {
        "neon.path": {
          "type": "string",
          "default": "neon",
          "scope": "machine",
          "description": "Path to the neon binary used to format documents. A bare name is looked up on PATH. A relative path resolves against the extension host's working directory, so use a bare name on PATH or an absolute path."
        }
      }
    }
  },
  "scripts": {
    "test": "vscode-tmgrammar-test 'tests/*.test.n' && node tests/differential.js && node --test tests/extension.test.js tests/snippets.test.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^1.5.1",
    "vscode-textmate": "^7.0.1",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
