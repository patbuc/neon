pub enum Kind {
    Circle
    Square
}

pub struct Shape {
    kind
    size
}

pub var created = 0

pub fn make(kind, size) {
    created += 1
    Shape(kind, size)
}

pub fn area(shape) {
    match shape.kind {
        Kind.Circle -> 3 * shape.size * shape.size
        Kind.Square -> shape.size * shape.size
    }
}
