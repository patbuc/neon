export enum Kind {
    Circle
    Square
}

export struct Shape {
    kind
    size
}

export var created = 0

export fn make(kind, size) {
    created += 1
    Shape(kind, size)
}

export fn area(shape) {
    match shape.kind {
        Kind.Circle -> 3 * shape.size * shape.size
        Kind.Square -> shape.size * shape.size
    }
}
