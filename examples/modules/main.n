// Expected:
// Kind.Circle: 12
// Kind.Square: 9
// total: 21
// shapes made: 2

use "lib/shapes"
use "lib/text-utils" as text

val all = [shapes.make(shapes.Kind.Circle, 2), shapes.make(shapes.Kind.Square, 3)]

var total = 0
for shape in all {
    val area = shapes.area(shape)
    print(text.label(shape.kind, area))
    total += area
}

print(text.label("total", total))
print(text.label("shapes made", shapes.created))
